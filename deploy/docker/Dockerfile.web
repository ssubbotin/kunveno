# nginx with the built web client. The official image renders templates/*.template with envsubst
# on start, substituting only variables defined in the environment (nginx's own $vars are kept).
FROM nginx:1.27-alpine
RUN rm -f /etc/nginx/conf.d/default.conf
COPY web/ /usr/share/nginx/kunveno/
COPY nginx.conf.template /etc/nginx/templates/kunveno.conf.template
