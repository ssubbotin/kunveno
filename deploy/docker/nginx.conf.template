# Rendered by the nginx image entrypoint into /etc/nginx/conf.d/kunveno.conf.
# The container runs with host networking, so the upstream is the server's loopback listener.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen ${HTTP_PORT};
    server_name ${SERVER_NAME};
    return 301 https://$host:${HTTPS_PORT}$request_uri;
}

server {
    listen ${HTTPS_PORT} ssl;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/ssl/kunveno/fullchain.pem;
    ssl_certificate_key /etc/ssl/kunveno/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /usr/share/nginx/kunveno;
    index index.html;
    # The static files come with gzip copies made at build time. Nothing is compressed on the fly:
    # the API answers are small, and compressing them over TLS invites BREACH-style attacks.
    gzip_static on;
    gzip_vary on;

    location / {
        try_files $uri /index.html;
    }

    # $http_host keeps a non-default port, so the server's same-origin check matches the browser Origin.
    location /ws {
        proxy_pass http://${KUNVENO_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # Recording downloads are hundreds of megabytes: stream them, no temp file, no timeout cut.
    location ~ "^/api/rooms/[a-z0-9-]+/recording/[0-9a-f]{32}$" {
        proxy_pass http://${KUNVENO_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_buffering off;
        proxy_max_temp_file_size 0;
        proxy_read_timeout 1h;
    }

    location /api/ {
        proxy_pass http://${KUNVENO_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    # Grafana serves itself from the /grafana/ subpath; it needs the original host and upgrades for live updates.
    # A password wall comes first (grafana-wall.sh writes its file), so only people who know it reach
    # Grafana's code; Grafana's own login follows. The wall's credentials stay here.
    location /grafana/ {
        auth_basic "Monitoring";
        auth_basic_user_file /etc/nginx/kunveno-grafana.htpasswd;
        proxy_set_header Authorization "";
        proxy_pass http://127.0.0.1:${GRAFANA_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location = /healthz {
        proxy_pass http://${KUNVENO_UPSTREAM};
    }
}
