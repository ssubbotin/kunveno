# Copy to .env next to docker-compose.yml.
SERVER_NAME=_
HTTP_PORT=80
HTTPS_PORT=443
# Must match http.listen in config.yaml.
KUNVENO_UPSTREAM=127.0.0.1:8080
# Delay of the sound-check echo (the "Эхо-тест" button in a room).
ECHO_DELAY=2s
# Monitoring. Grafana is at https://<PUBLIC_HOST>/grafana/ (user admin).
PUBLIC_HOST=meet.example.internal
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3000
PROMETHEUS_PORT=9095
PROMETHEUS_RETENTION=30d
