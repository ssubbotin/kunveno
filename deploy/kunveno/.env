# Settings of the kunveno stack, read by docker-compose.yml. Fill in the two required values.

# Required: the host name or IP address users open in the browser. It goes into the self-signed
# certificate issued on first start and into Grafana's links.
PUBLIC_HOST=
# Required: Grafana's admin password, read on Grafana's first start. Generate one with
#   openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=

# Optional; the defaults are shown.
# The address browsers send media to. Default: the host's primary IPv4 address. Set it when users
# reach the host through another one, for example its VPN address.
#KUNVENO_ADVERTISE_IP=
# Release to run, for example 0.2.4 to stay on it, or pr-<number> for a preview. Default: latest.
#KUNVENO_VERSION=
#HTTP_PORT=80
#HTTPS_PORT=443
#SERVER_NAME=_
# Loopback address of the server (nginx, echo, player and Prometheus reach it there); change it
# when port 8080 is taken on the host.
#KUNVENO_UPSTREAM=127.0.0.1:8080
# More names for the self-signed certificate besides PUBLIC_HOST, comma-separated.
#TLS_NAMES=
# Delay of the sound-check echo (the "Эхо-тест" button in a room).
#ECHO_DELAY=2s
#GRAFANA_PORT=3000
# The password wall nginx puts in front of /grafana/: the browser asks for it before Grafana's own
# login. Default user admin; the password defaults to GRAFANA_ADMIN_PASSWORD.
#GRAFANA_WALL_USER=admin
#GRAFANA_WALL_PASSWORD=
#PROMETHEUS_PORT=9095
#PROMETHEUS_RETENTION=30d
#NODE_EXPORTER_PORT=9105
